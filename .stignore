// Syncthing Ignore Patterns for whats-gtk
// SQLite uses DELETE journal mode (single-file app.db) so transactions commit directly to app.db.
// Temporary rollback journals and lock files during transactions are ignored.
*.db-journal
*.db-wal
*.db-shm

// Session store must NOT be synced between machines (Signal protocol Double Ratchet is stateful per-device)
store.db
store.db*

// Ignore compiled binary executables
whats-gtk

// Ignore git index lock files
.git/index.lock
